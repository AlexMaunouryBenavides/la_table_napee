    "react-router": "7.15.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/maitree": "^5.3.0",
    "@fontsource/ruthie": "^5.3.0",
    "@react-router/dev": "7.15.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^7.0.1",
