{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["tailwindcss", "pino-pretty", "@fontsource/*"],
  "workspaces": {
    "api": {
      "entry": [
        "src/main.ts",
        "src/config/data-source.ts",
        "src/migrations/*.ts",
        "src/**/*.spec.ts",
        "test/**/*.e2e-spec.ts"
      ],
      "project": "src/**/*.ts"
    },
    "client": {
      "project": "app/**/*.{ts,tsx}"
    },
    "packages/types": {
      "project": "src/**/*.ts"
    }
  }
}
