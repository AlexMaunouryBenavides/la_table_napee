# Copie ce fichier en `.env` (non commité) et adapte les valeurs.

# REQUIS — origine exacte du front pour le CORS crédentialisé. Jamais "*".
FRONT_ORIGIN=http://localhost:5173

# REQUIS — connexion MySQL. Le mot de passe ne va JAMAIS dans le dépôt.
DB_HOST=localhost
DB_USERNAME=recipe
DB_PASSWORD=change-moi
DB_DATABASE=recipe

# Optionnel — port MySQL (défaut 3306).
DB_PORT=3306

# REQUIS pour `npm run test:e2e` — base DISTINCTE de celle du développement.
# Les tests e2e vident des tables : ils refusent de tourner sans elle.
DB_DATABASE_TEST=recipe_test

# REQUIS — secret de signature des JWT, 32 caractères minimum. Aucune valeur par
# défaut : qui connaît ce secret fabrique un jeton « admin » valide. Génère le tien
# avec `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=remplace-moi-par-une-valeur-aleatoire-de-32-caracteres-minimum

# Optionnel — durées de vie des jetons (défauts : 15 minutes et 7 jours).
# L'access est court exprès : il borne la fenêtre où un rôle retiré reste actif.
ACCES_MINUTES=15
RAFRAICHISSEMENT_JOURS=7

# Optionnel — port d'écoute de l'API (défaut 3000).
PORT=3000

# Optionnel — development | production | test (défaut development).
NODE_ENV=development

# Optionnel — anti-bruteforce : fenêtre en millisecondes et nombre de requêtes.
THROTTLER_TTL=60000
THROTTLER_LIMIT=100

# Optionnel — niveau de log pino : trace|debug|info|warn|error|fatal (défaut info).
LOG_LEVEL=info
